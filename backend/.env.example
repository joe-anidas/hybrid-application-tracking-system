MONGO_URI=mongodb://localhost:27017/ats
PORT=3000
# Use a strong random secret in production
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# =================================
# ENVIRONMENT & LOGGING
# =================================
NODE_ENV=development
LOG_LEVEL=info

# =================================
# GRAFANA CLOUD - LOKI (Logs)
# =================================
# Enable Loki integration (set to 'true' in production)
LOKI_ENABLED=false

# Your Grafana Cloud Loki endpoint
# Find this in: Grafana Cloud > Loki > Details
LOKI_HOST=logs-prod-us-central1.grafana.net

# Your Grafana Cloud instance ID (username)
# Find this in: Grafana Cloud > Loki > Details
LOKI_USERNAME=123456

# Your Grafana Cloud API key (password)
# Create this in: Grafana Cloud > Security > API Keys
# Needs "MetricsPublisher" role
LOKI_PASSWORD=your-loki-api-key-here

# =================================
# GRAFANA CLOUD - PROMETHEUS (Metrics)
# =================================
# Enable Prometheus metrics endpoint (set to 'true' in production)
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# =================================
# GRAFANA CLOUD - OPENTELEMETRY (Traces & Metrics)
# =================================
# Enable OpenTelemetry (set to 'true' in production)
OTEL_ENABLED=false

# Tempo (Traces) endpoint
# Find this in: Grafana Cloud > Tempo > Details > OpenTelemetry OTLP
OTEL_TRACES_ENDPOINT=https://tempo-us-central1.grafana.net/otlp

# Prometheus (Metrics via OTLP) endpoint
# Find this in: Grafana Cloud > Prometheus > Details > OpenTelemetry OTLP
OTEL_METRICS_ENDPOINT=https://prometheus-us-central1.grafana.net/api/prom/push

# Base64 encoded "instanceID:APIKey"  
# Create API key in: Grafana Cloud > Security > API Keys (needs "MetricsPublisher" role)
# Then encode: echo -n "instanceID:APIKey" | base64
# Example: echo -n "123456:glc_xxxxx" | base64
GRAFANA_CLOUD_OTLP_AUTH=your-base64-encoded-auth-here
